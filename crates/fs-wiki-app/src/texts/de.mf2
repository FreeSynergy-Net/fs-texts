# Die Texte des Wiki-Fensters, Deutsch (ADR 0057: MessageFormat 2). Jede Id braucht ihr englisches Gegenstück in en.mf2.
# Ein Loch `{$x}` wird mit dem gefüllt, wovon der Satz spricht. Die Wörter der Layouts und des Lesers stehen NICHT hier:
# `fs-components` besitzt sie (`WikiLabels::for_locale`, `Labels::for_locale`), eine Stelle für alle Programme.

menu-program = Programm
menu-quit = Beenden
menu-view = Ansicht
menu-frontend = Frontend: {$name}
menu-page = Seite
page-new = Neue Seite
page-subpage = Neue Unterseite
page-rename = Umbenennen
page-delete = Löschen
page-discard = Entwurf verwerfen
reason-read-only = nur lesen: dieses Wiki wird hier nicht bearbeitet (ohne --read-only oder mit --edit starten, um Seiten zu ändern)
reason-read-only-sources = nur lesen: die Dokumentationsordner bleiben die Wahrheit (mit --edit starten, um ihre Seiten zu ändern)
reason-no-write = Seiten können nicht gespeichert werden: kein Schreibrecht für {$path} (Rechte dieses Ordners prüfen oder mit XDG_DATA_HOME einen anderen Datenordner wählen)
reason-no-page = keine Seite offen
reason-no-draft = nichts wird bearbeitet
reason-editing = erst die Bearbeitung beenden
reason-variants = Seiten mit Sprachfassungen werden hier nicht geändert

msg-need-page = Zuerst eine Seite öffnen: die neue Seite wird ihre Unterseite.
msg-finish-edit = Erst die Änderungen speichern oder verwerfen, dann die Seiten ändern.
msg-created = Seite angelegt ({$path}). Text schreiben, dann speichern (Strg+S).
msg-renamed = Seite umbenannt: jetzt {$path}. Ihre Unterseiten und die Links auf sie sind mitgezogen; ihr Verlauf bleibt.
msg-deleted = In den Papierkorb gelegt: {$title}. Aus dem Papierkorb lässt sie sich zurückholen (Admin-Fenster).
msg-discarded = Der Entwurf ist verworfen.
msg-discarded-new = Die neue Seite wurde nie gespeichert; sie liegt im Papierkorb.
msg-frontend-not-kept = Das Frontend konnte nicht gemerkt werden.

dlg-delete-title = {$title} löschen?
dlg-delete-body = Die Seite kommt in den Papierkorb. Von dort lässt sie sich zurückholen.
dlg-delete-body-sub =
  .input {$count :number}
  .match $count one {{Die Seite und ihre Unterseiten (insgesamt {$count} Seite) kommen in den Papierkorb. Von dort lassen sie sich zurückholen.}} * {{Die Seite und ihre Unterseiten (insgesamt {$count} Seiten) kommen in den Papierkorb. Von dort lassen sie sich zurückholen.}}
dlg-delete-yes = Löschen
dlg-discard-title = Entwurf von {$title} verwerfen?
dlg-discard-body = Was du getippt hast, ist nicht gespeichert und geht verloren.
dlg-discard-new-body = Die Seite wurde eben erst angelegt und nie gespeichert. Sie kommt in den Papierkorb.
dlg-discard-yes = Verwerfen
dlg-keep = Behalten

err-read-only = Das Wiki ist hier nur lesbar; nichts wurde geändert.
err-empty = Der Name ist leer.
err-no-letter = Der Name braucht mindestens einen Buchstaben oder eine Ziffer, aus der sich ein Pfad machen lässt.
err-chars = Der Name darf keinen Schrägstrich, keinen Rückwärtsstrich und keine Steuerzeichen enthalten.
err-taken = Eine Seite „{$name}“ gibt es schon.
err-invalid = Der Pfad ist nicht erlaubt ({$why}).
err-failed = Das hat nicht geklappt: {$why}
err-not-found = Unter {$path} gibt es keine Seite mehr.
err-variants = Seiten mit Sprachfassungen werden in diesem Fenster nicht geändert.
err-index = Eine Indexseite trägt den Namen ihres Ordners; den Ordner im Admin-Fenster umbenennen.
err-partial = Die Seite wurde umbenannt und liegt jetzt unter {$path}, aber der Titel in ihrem Text ließ sich nicht ändern: {$why}
err-half = Nur ein Teil wurde erledigt: {$why}. Nichts ist verloren; im Seitenbaum und im Papierkorb nachsehen.
err-reserved = Der Name index ist für die Indexseite eines Ordners reserviert; bitte einen anderen Namen nehmen.

lang-label = Sprache
lang-name =
  .input {$code :string}
  .match $code de {{Deutsch}} en {{Englisch}} * {{{$code}}}
lang-own =
  .input {$code :string}
  .match $code de {{Deutsch}} en {{English}} * {{{$code}}}
lang-only-in = Diese Seite gibt es nur auf {$lang}.
lang-outdated = Diese Übersetzung ist veraltet: das Original ({$lang}) wurde danach geändert.

admin-menu-program = Programm
admin-menu-view = Ansicht
admin-menu-help = Hilfe
admin-menu-quit = Beenden
admin-menu-about = Über
admin-action-add = Hinzufügen
admin-action-back = Zurück
admin-action-cancel = Abbrechen
admin-action-close = Schließen
admin-action-remove = Entfernen
admin-action-save = Speichern
admin-message-done = Erledigt.
admin-message-rejected = Das Wiki hat das abgelehnt: ein Wert ist nicht erlaubt, der Pfad ist vergeben oder die Seite ist nicht leer. Die markierten Felder prüfen.
admin-message-not-found = Diese Seite, dieser Ordner oder dieser Befehl existiert nicht mehr; die Liste ist vielleicht alt.
admin-message-unavailable = Das Wiki hat das nicht getan: der Server hat es abgelehnt oder bietet den Befehl noch nicht an. Der Grund steht im Protokoll des Programms.
admin-message-unsaved = Es gibt Text, der noch nicht gesendet ist.
admin-list-empty = Hier ist nichts.
admin-list-stale = Die Liste ist vielleicht alt.
admin-detail-not-loaded = Nicht geladen.
admin-confirm-sure = Bist du sicher?
admin-value-none = keiner
admin-about-version = Version
admin-about-origin = Herkunft
admin-about-licence = Lizenz
admin-about-repository = Repository
admin-about-unoffered = Nicht angeboten
admin-type-page = Seiten
admin-type-folder = Ordner
admin-type-revision = Verlauf
admin-type-trash = Papierkorb
admin-type-link = Links
