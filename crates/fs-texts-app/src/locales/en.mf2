# The words of the wiki window, English (ADR 0057: MessageFormat 2). Every id needs a German twin in de.mf2.
# A hole `{$x}` is filled with the thing the sentence talks about. The words of the layouts and of the reader are NOT here:
# `fs-components` owns them (`WikiLabels::for_locale`, `Labels::for_locale`), one place for every program.

menu-program = Program
menu-quit = Quit
menu-view = View
menu-frontend = Frontend: {$name}
menu-page = Page
page-new = New page
page-subpage = New subpage
page-rename = Rename
page-delete = Delete
page-discard = Discard draft
reason-read-only = read only: this wiki is not edited here (start without --read-only, or with --edit, to change pages)
reason-read-only-sources = read only: the documentation folders stay the truth (start with --edit to change their pages)
reason-no-write = pages cannot be saved: no write access to {$path} (check the permissions of that folder, or choose another data folder with XDG_DATA_HOME, on Windows LOCALAPPDATA, or --origins FILE)
reason-no-page = no page is open
reason-no-draft = nothing is being edited
reason-editing = finish the edit first
reason-variants = pages with language variants are not changed here

msg-need-page = Open a page first: the new page becomes its subpage.
msg-finish-edit = Save or discard the changes first, then change the pages.
msg-created = Page made ({$path}). Write the text, then save (Ctrl+S).
msg-renamed = Page renamed: now {$path}. Its subpages and the links to it moved along; its history stays.
msg-deleted = Moved to the trash: {$title}. It can be restored from the trash (Admin window).
msg-discarded = The draft is discarded.
msg-discarded-new = The new page was never saved; it moved to the trash.
msg-frontend-not-kept = The frontend could not be remembered.

dlg-delete-title = Delete {$title}?
dlg-delete-body = The page moves to the trash. It can be restored from there.
dlg-delete-body-sub =
  .input {$count :number}
  .match $count one {{The page and its subpages ({$count} page in all) move to the trash. They can be restored from there.}} * {{The page and its subpages ({$count} pages in all) move to the trash. They can be restored from there.}}
dlg-delete-yes = Delete
dlg-discard-title = Discard the draft of {$title}?
dlg-discard-body = What you typed is not saved and will be lost.
dlg-discard-new-body = The page was made just now and never saved. It moves to the trash.
dlg-discard-yes = Discard
dlg-keep = Keep

err-read-only = The wiki is read only here; nothing was changed.
err-empty = The name is empty.
err-no-letter = The name needs at least one letter or digit to make a path from.
err-chars = The name must not contain a slash, a backslash or control characters.
err-taken = A page called {$name} exists already.
err-invalid = The path is not allowed ({$why}).
err-failed = This did not work: {$why}
err-not-found = There is no page at {$path} any more.
err-variants = Pages with language variants are not changed in this window.
err-index = An index page has the name of its folder; rename the folder in the Admin window.
err-partial = The page was renamed and is now at {$path}, but the title in its text could not be changed: {$why}
err-half = Only part of it was done: {$why}. Nothing is lost; look at the page tree and the trash.
err-reserved = The name index is kept for the index page of a folder; take another name.

lang-label = Language
lang-name =
  .input {$code :string}
  .match $code de {{German}} en {{English}} * {{{$code}}}
lang-own =
  .input {$code :string}
  .match $code de {{Deutsch}} en {{English}} * {{{$code}}}
lang-only-in = This page is only available in {$lang}.
lang-outdated = This translation is outdated: the original ({$lang}) was changed after it was translated.

admin-menu-program = Program
admin-menu-view = View
admin-menu-help = Help
admin-menu-quit = Quit
admin-menu-about = About
admin-action-add = Add
admin-action-back = Back
admin-action-cancel = Cancel
admin-action-close = Close
admin-action-remove = Remove
admin-action-save = Save
admin-message-done = Done.
admin-message-rejected = The wiki refused this: a value is not allowed, or the path is taken, or the page is not empty. Check the marked fields.
admin-message-not-found = There is no such page, folder or command any more; the list may be old.
admin-message-unavailable = The wiki did not do this: the server refused it or does not offer the command yet. The reason is written to the log of the program.
admin-message-unsaved = There is text that is not sent yet.
admin-list-empty = Nothing here.
admin-list-stale = The list may be old.
admin-detail-not-loaded = Not loaded.
admin-confirm-sure = Are you sure?
admin-value-none = none
admin-about-version = Version
admin-about-origin = Origin
admin-about-licence = Licence
admin-about-repository = Repository
admin-about-unoffered = Not offered
admin-type-page = Pages
admin-type-folder = Folders
admin-type-revision = History
admin-type-trash = Trash
admin-type-link = Links

start-title = Texts cannot start
start-title-wiki = The wiki cannot start
start-title-facet = {$name} cannot start
start-retry = Try again
start-close-old = If an older fs-texts or fs-wiki window is still open, close it first: it holds the database.
problem-no-socket = No place for the server socket: XDG_RUNTIME_DIR is not set (log in with a full desktop session, or start with --socket PATH).
problem-runtime-folder = The folder for the server socket cannot be written: {$path}. Check its owner and permissions (it must belong to the user who runs the window), or start with --socket PATH.
problem-data-folder = The data folder cannot be written: {$path}. Check its owner and permissions (it must belong to the user who runs the window), or choose another place with XDG_DATA_HOME.
problem-server = No server could be reached or started on {$path}. The window ran: {$command}. The answer was: {$error}.
problem-failed = The start failed: {$error}.

name-program = Texts
name-facet-wiki = Wiki
empty-title = No pages yet.
empty-hint = Make the first page.
reason-empty = Choose a page in the tree or make a new one (menu Page > New page).
reason-lost = server not reachable (choose "Reconnect" in the window)
link-lost-title = Connection to the server lost
link-lost-status = {$name}: connection to the server lost ({$path}): {$error}
link-lost-body = The server on {$path} no longer answers: {$error}. Pages can only be saved again when it runs. "Reconnect" starts the server again as at the start.
link-reconnect = Reconnect
link-close = Close
link-back = The connection to the server is back.
link-no-lease = The server may end by itself after a while: the lease file {$path} could not be held ({$error}).
menus-not-set = The menus could not be set: {$error}
tree-not-drawn = The page tree could not be drawn; restart the program.

diagnose-title = Diagnosis: {$name} (facet: {$facet})
diagnose-line = {$what}: {$value}
diagnose-none = none
diagnose-unset = not set
diagnose-unknown = unknown
diagnose-missing = missing
diagnose-writable = writable
diagnose-not-writable = NOT writable
diagnose-owner-me = owned by this user:
diagnose-owner-other = owned by ANOTHER user:
diagnose-version = Program version
diagnose-binary = Program file
diagnose-user = User id of this process
diagnose-env-runtime = XDG_RUNTIME_DIR
diagnose-env-data = XDG_DATA_HOME
diagnose-env-home = HOME
diagnose-socket = Socket
diagnose-runtime = Runtime folder
diagnose-socket-file = Socket file
diagnose-lease = Lease
diagnose-lease-ok = present, a shared lock can be taken
diagnose-lease-held = present, the lock cannot be taken ({$error})
diagnose-server = Server
diagnose-no-server = not reachable ({$error}); the diagnosis starts no server
diagnose-answers = answers (list read)
diagnose-answers-not = connected, but the list fails ({$error})
diagnose-data = Data folder
